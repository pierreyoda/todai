{
  "name": "todai",
  "version": "0.1.0",
  "description": "A personal, day-by-day tasks-management and notes-taking application.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "TZ=UTC vitest run",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "license": "MIT",
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@humanspeak/svelte-markdown": "2.1.3",
    "@tanstack/svelte-query": "6.3.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@thisux/sveltednd": "0.8.0",
    "date-fns": "4.4.0",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "imports": {
    "#shared/*": "./src/lib/shared/*",
    "#core/*": "./src/lib/core/*/index.ts",
    "#domains/*": "./src/lib/domains/*/index.ts",
    "#shell/*": "./src/lib/shell/*"
  }
}
